+fn recover_claude_pending_package_update(started_unix_ms: u128) -> Option<Result<(), String>> {
+    let script = CLAUDE_PENDING_PACKAGE_RECOVERY_SCRIPT
+        .replace("STARTED_UNIX_MS", &started_unix_ms.to_string());
