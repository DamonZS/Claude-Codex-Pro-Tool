+fn recover_failed_claude_launch<R, L>(
+    mut outcome: ClaudeLaunchOutcome,
+    recover: R,
+    relaunch: L,
+) -> ClaudeLaunchOutcome
+where
+    R: FnOnce() -> Option<Result<(), String>>,
+    L: FnOnce() -> ClaudeLaunchOutcome,
+{
+    if outcome.ready
+        || outcome.process_id.is_some()
+        || !outcome
+            .diagnostics
+            .iter()
+            .any(|diagnostic| diagnostic.contains("HRESULT 0x80070005"))
+    {
+        return outcome;
+    }
+    match recover() {
+        None => outcome,
+        Some(Err(error)) => {
+            outcome.diagnostics.push(format!(
+                "Claude 待更新包注册恢复失败（{}）；未修改用户数据",
+                sanitized_claude_launch_error(&error)
+            ));
+            outcome
+        }
+        Some(Ok(())) => {
+            outcome
+                .diagnostics
+                .push("Claude 待更新包已通过 Windows 官方注册恢复，重新验证启动".to_string());
+            let mut retried = relaunch();
+            outcome.diagnostics.append(&mut retried.diagnostics);
+            retried.diagnostics = outcome.diagnostics;
+            retried
+        }
+    }
+}
