+        return None;
+    }
+    if value.get("success").and_then(Value::as_bool) == Some(true) {
+        Some(Ok(()))
+    } else {
+        Some(Err(value
+            .get("errorCode")
+            .and_then(Value::as_str)
+            .unwrap_or("registration_failed")
+            .to_string()))
+    }
