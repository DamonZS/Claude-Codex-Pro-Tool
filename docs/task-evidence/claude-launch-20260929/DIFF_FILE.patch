+#[cfg(windows)]
+const CLAUDE_PENDING_PACKAGE_RECOVERY_SCRIPT: &str = r#"
+[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
+$OutputEncoding = [Console]::OutputEncoding
+$ErrorActionPreference = 'Stop'
+$attempted = $false
+try {
+    $pkg = Get-AppxPackage -Name Claude
+    if (-not $pkg -or (Get-Process -Name Claude -ErrorAction SilentlyContinue)) {
+        @{ attempted = $false } | ConvertTo-Json -Compress
+        exit 0
+    }
+    $started = [DateTimeOffset]::FromUnixTimeMilliseconds(STARTED_UNIX_MS).UtcDateTime
+    $sid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
+    $publisherId = $pkg.PackageFamilyName.Substring($pkg.Name.Length + 1)
+    $pattern = '^' + [regex]::Escape($pkg.Name) + '_(\d+\.\d+\.\d+\.\d+)_[^_]+_[^_]*_' + [regex]::Escape($publisherId) + '$'
+    $events = Get-WinEvent -FilterHashtable @{
+        LogName = 'Microsoft-Windows-AppXDeploymentServer/Operational'
+        Id = 404
+        StartTime = $started
+    } -MaxEvents 32 -ErrorAction SilentlyContinue
+    $pending = $false
+    foreach ($event in $events) {
+        [xml]$xml = $event.ToXml()
+        if ($xml.Event.System.Security.UserID -ne $sid) { continue }
+        $fields = @{}
+        foreach ($field in $xml.Event.EventData.Data) { $fields[[string]$field.Name] = [string]$field.'#text' }
+        if ($fields.ErrorCode -eq '0x80070005' -and $fields.PackageFullName -match $pattern -and
+            [version]$Matches[1] -gt [version]$pkg.Version) {
+            $pending = $true
+            break
+        }
+    }
+    if (-not $pending -or (Get-Process -Name Claude -ErrorAction SilentlyContinue)) {
+        @{ attempted = $false } | ConvertTo-Json -Compress
+        exit 0
+    }
+    $attempted = $true
+    Add-AppxPackage -RegisterByFamilyName -MainPackage $pkg.PackageFamilyName -ForceTargetApplicationShutdown -ErrorAction Stop
+    $updated = Get-AppxPackage -Name Claude
+    if (-not $updated -or [version]$updated.Version -le [version]$pkg.Version) {
+        throw 'Claude package registration did not advance'
+    }
+    @{ attempted = $true; success = $true } | ConvertTo-Json -Compress
+} catch {
+    $code = if ("$_" -match '0x80070005') { '0x80070005' } else { 'registration_failed' }
+    @{ attempted = $attempted; success = $false; errorCode = $code } | ConvertTo-Json -Compress
+}
+"#;
+
+#[cfg(windows)]
+fn recover_claude_pending_package_update(started_unix_ms: u128) -> Option<Result<(), String>> {
+    let script = CLAUDE_PENDING_PACKAGE_RECOVERY_SCRIPT
+        .replace("STARTED_UNIX_MS", &started_unix_ms.to_string());
+    let value = powershell_json(&script).ok()??;
+    if value.get("attempted").and_then(Value::as_bool) != Some(true) {
+        return None;
+    }
+    if value.get("success").and_then(Value::as_bool) == Some(true) {
+        Some(Ok(()))
+    } else {
+        Some(Err(value
+            .get("errorCode")
+            .and_then(Value::as_str)
+            .unwrap_or("registration_failed")
+            .to_string()))
+    }
+}
